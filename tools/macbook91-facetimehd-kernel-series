#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# macbook91-facetimehd-kernel-series: on which Linux kernel series the camera
# driver has been tested, and a short note after a pacman transaction for every
# installed kernel of another series.
#
# DKMS builds the driver for every kernel (dkms.conf sets no
# BUILD_EXCLUSIVE_KERNEL), so this builds and blocks nothing. The one list of
# tested series is TESTED-SERIES in the installed DKMS source tree; this script
# is its only reader. The pacman hook 71-macbook91-facetimehd-series.hook calls
# --hook. Installed as /usr/lib/macbook91-facetimehd/kernel-series.
#
# A kernel belongs to series X.Y when its release starts with "X.Y.".
#
#   kernel-series --list   the tested series, space-separated, on stdout
#   kernel-series --hook   a note on stderr for each installed kernel of an
#                          untested series; exit 0 with or without notes
#
#   --series-file FILE     the list to read (default: the installed source tree)
#   --modules-root DIR     where --hook looks for kernels (default /usr/lib/modules)
#   -h, --help             the full help on stdout
#   -V, --version          name and version on stdout
#
# Exit 1: the list is missing, unreadable or malformed. Exit 2: bad arguments.
#
# Message lines keep the prefix "macbook91-facetimehd:" because pacman prints
# them inside its transaction output (hook). The text of the --hook note is
# read by people and by tests: keep it stable.
set -u

# The Makefile substitutes the version on install; from a checkout it is read
# from ../VERSION.
PKGVER=@PKGVER@
case $PKGVER in
	@*@) PKGVER=$(cat "$(dirname "$0")/../VERSION" 2>/dev/null) || PKGVER=unknown ;;
esac
SERIES_FILE=/usr/src/macbook91-facetimehd-$PKGVER/TESTED-SERIES
MODULES_ROOT=/usr/lib/modules
MODE=''
CMD=/usr/lib/macbook91-facetimehd/kernel-series

fail() { printf 'macbook91-facetimehd: error: %s\n' "$*" >&2; exit 1; }
usage() { # MESSAGE
	printf 'macbook91-facetimehd: error: %s\n' "$*" >&2
	printf 'Usage: %s (--list|--hook) [--series-file FILE] [--modules-root DIR]\n' "$CMD" >&2
	printf 'Example: %s --list\n' "$CMD" >&2
	printf 'Help: %s --help\n' "$CMD" >&2
	exit 2
}
usage_full() {
	cat <<EOF
Usage: $CMD (--list|--hook) [--series-file FILE] [--modules-root DIR]

Reports on which Linux kernel series the macbook91-facetimehd camera driver
has been tested. The pacman hook calls it after kernel and driver transactions.
It builds and blocks nothing.

Examples:
  $CMD --list    the tested series, for example "6.18 7.2"
  $CMD --hook    a note for each installed kernel of an untested series

Options:
      --list               print the tested series, space-separated, on stdout
      --hook               print a note on stderr for each installed kernel of an
                           untested series; exit 0 with or without notes
      --series-file FILE   the list to read (default: TESTED-SERIES in the
                           installed DKMS source tree)
      --modules-root DIR   where --hook looks for kernels (default /usr/lib/modules)
  -h, --help               this help
  -V, --version            version

Files:
  /usr/src/macbook91-facetimehd-VERSION/TESTED-SERIES   the list of tested series

Exit status:
  0  success, with or without notes
  1  the list is missing, unreadable or malformed
  2  usage error

Docs and bug reports: https://github.com/Weegee/macbook91-facetimehd-pub
EOF
}

# -h and -V win over every other argument (HIL-1).
for a in "$@"; do
	case $a in
		-h|--help) usage_full; exit 0 ;;
		-V|--version) echo "macbook91-facetimehd-kernel-series (macbook91-facetimehd-dkms) $PKGVER"; exit 0 ;;
	esac
done

while [ $# -gt 0 ]; do
	case "$1" in
		--list|--hook) MODE=${1#--}; shift ;;
		--series-file)
			[ $# -ge 2 ] || usage "--series-file needs a file"
			SERIES_FILE=$2; shift 2 ;;
		--modules-root)
			[ $# -ge 2 ] || usage "--modules-root needs a directory"
			MODULES_ROOT=$2; shift 2 ;;
		*) usage "unknown argument '$1'" ;;
	esac
done
[ -n "$MODE" ] || usage "no mode given; use --list or --hook"

[ -r "$SERIES_FILE" ] || fail "cannot read the list of tested kernel series, $SERIES_FILE"
SERIES=()
while read -r s; do
	case "$s" in ''|'#'*) continue ;; esac
	[[ $s =~ ^[0-9]+\.[0-9]+$ ]] || fail "malformed series '$s' in $SERIES_FILE"
	SERIES+=("$s")
done < "$SERIES_FILE"
[ "${#SERIES[@]}" -gt 0 ] || fail "$SERIES_FILE lists no series"

tested() { # RELEASE -> exit 0 when it belongs to a tested series
	local s
	for s in "${SERIES[@]}"; do
		case "$1" in "$s".*) return 0 ;; esac
	done
	return 1
}

case "$MODE" in
	list)
		printf '%s\n' "${SERIES[*]}"
		;;
	hook)
		list=$(printf '%s, ' "${SERIES[@]}")
		list=${list%, }
		for d in "$MODULES_ROOT"/*/; do
			[ -e "$d/vmlinuz" ] || continue
			rel=$(basename "$d")
			tested "$rel" && continue
			if [[ $rel =~ ^([0-9]+\.[0-9]+)\. ]]; then
				what="Linux ${BASH_REMATCH[1]} (kernel $rel)"
			else
				what="kernel $rel"
			fi
			printf 'macbook91-facetimehd: note: the camera driver is not tested on %s; tested series: %s.\n' \
				"$what" "$list" >&2
			printf '  If the camera misbehaves on that kernel, boot the LTS kernel.\n' >&2
		done
		;;
esac
exit 0
