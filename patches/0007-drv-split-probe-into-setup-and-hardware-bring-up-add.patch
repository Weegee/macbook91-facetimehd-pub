 	debugfs_create_file("debug", S_IRUSR | S_IWUSR, d, dev_priv, &fops_debug);
+	debugfs_create_devm_seqfile(&dev_priv->pdev->dev, "state", d, seq_state_read);
+	debugfs_create_file("recover", S_IWUSR, d, dev_priv, &fops_recover);
 	dev_priv->debugfs = top;
 	return 0;
 }
