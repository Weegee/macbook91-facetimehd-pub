+/* Stop interrupt delivery and wait for handlers that are still running. */
+static void fthd_hw_quiesce(struct fthd_private *dev_priv)
+{
+	fthd_irq_disable(dev_priv);
+	synchronize_irq(dev_priv->pdev->irq);
 	cancel_work_sync(&dev_priv->irq_work);
+	/* A finishing irq work reopens the interrupt gate */
+	fthd_irq_disable(dev_priv);
