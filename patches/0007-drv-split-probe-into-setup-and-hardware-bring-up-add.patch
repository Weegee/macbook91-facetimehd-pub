+/*
+ * Cut and restore the camera power through the ACPI CMPE method. This is
+ * the only reset that also restarts a hung ISP CPU; the macOS driver does
+ * the same (DisableS2Chip: CMPE(0) + 250 ms, EnableS2Chip: CMPE(1) + 20 ms).
+ * The PCI config space is lost with the power and is restored afterwards.
+ */
+static int fthd_power_cycle(struct fthd_private *dev_priv)
+{
+	struct pci_dev *pdev = dev_priv->pdev;
+	u32 id;
+	int ret;
 
-	if (dev_priv->s2_io)
-		iounmap(dev_priv->s2_io);
-	if (dev_priv->s2_mem)
-		iounmap(dev_priv->s2_mem);
-	if (dev_priv->isp_io)
-		iounmap(dev_priv->isp_io);
+	pci_read_config_dword(pdev, PCI_VENDOR_ID, &id);
+	if (id == (PCI_VENDOR_ID_BROADCOM | (pdev->device << 16)))
+		pci_save_state(pdev);
+	else
+		pdev->state_saved = true; /* the copy from the last bring-up */
 
-	pci_release_region(pdev, FTHD_PCI_S2_IO);
-	pci_release_region(pdev, FTHD_PCI_S2_MEM);
-	pci_release_region(pdev, FTHD_PCI_ISP_IO);
+	pci_clear_master(pdev);
+
+	ret = isp_acpi_set_power(dev_priv, 0);
+	if (ret)
+		return ret;
+	msleep(250);
+
+	ret = isp_acpi_set_power(dev_priv, 1);
+	if (ret)
+		return ret;
+	msleep(20);
+
+	pci_restore_state(pdev);
+	pci_read_config_dword(pdev, PCI_VENDOR_ID, &id);
+	if (id != (PCI_VENDOR_ID_BROADCOM | (pdev->device << 16))) {
+		dev_err(&pdev->dev,
+			"camera did not return after power cycle (id %08x)\n", id);
+		return -ENODEV;
+	}
+	/* PME_En comes up undefined; the PCI core keeps it off in D0 */
+	pci_pme_active(pdev, false);
+	pci_save_state(pdev);
+
+	return 0;
