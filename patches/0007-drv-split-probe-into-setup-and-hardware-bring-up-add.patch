+static void fthd_pci_remove(struct pci_dev *pdev)
+{
+	struct fthd_private *dev_priv;
+
+	dev_priv = pci_get_drvdata(pdev);
+	if (!dev_priv)
+		goto out;
+
+	mutex_lock(&dev_priv->vb2_queue_lock);
+	dev_priv->removing = true;
+	mutex_unlock(&dev_priv->vb2_queue_lock);
+	cancel_work_sync(&dev_priv->recover_work);
+
+	fthd_debugfs_exit(dev_priv);
+
+	mutex_lock(&dev_priv->vb2_queue_lock);
+	fthd_hw_teardown(dev_priv);
+	mutex_unlock(&dev_priv->vb2_queue_lock);
+
+	fthd_v4l2_unregister(dev_priv);
+
+	pci_set_drvdata(pdev, NULL);
+	fthd_irq_uninstall(dev_priv);
+	pci_disable_msi(pdev);
+	fthd_pci_unmap(dev_priv);
 	kfree(dev_priv);
 out:
