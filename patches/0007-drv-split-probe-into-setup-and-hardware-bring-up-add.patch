+/*
+ * Bring the S2 chip from reset to a running ISP firmware. Everything set up
+ * here lives in S2 memory and is lost when the chip loses power.
+ */
+static int fthd_hw_bringup(struct fthd_private *dev_priv)
+{
+	int ret;
+
+	dev_priv->hw_state = FTHD_HW_STARTING;
+
+	ret = fthd_buffer_init(dev_priv);
+	if (ret)
+		goto fail;
 
+	ret = fthd_hw_init(dev_priv);
+	if (ret)
+		goto fail_buffer;
+
+	ret = fthd_firmware_start(dev_priv);
+	if (ret)
+		goto fail_isp;
+
+	dev_priv->hw_state = FTHD_HW_UP;
+	return 0;
+
+fail_isp:
+	dev_priv->hw_state = FTHD_HW_DOWN;
+	fthd_hw_quiesce(dev_priv);
+	isp_uninit(dev_priv);
 	fthd_hw_deinit(dev_priv);
+fail_buffer:
+	fthd_buffer_exit(dev_priv);
+fail:
+	dev_priv->hw_state = FTHD_HW_DOWN;
+	return ret;
+}
+
+/*
+ * Undo fthd_hw_bringup(). The firmware is only asked to stop when it is
+ * known to respond; a hung ISP CPU is halted by isp_uninit() instead.
+ * Queued buffers stay with the driver and are mapped again on bring-up.
+ */
+static void fthd_hw_teardown(struct fthd_private *dev_priv)
+{
+	if (dev_priv->hw_state == FTHD_HW_DOWN)
+		return;
 
+	if (dev_priv->hw_state == FTHD_HW_UP)
+		fthd_stop_firmware(dev_priv);
+
+	dev_priv->hw_state = FTHD_HW_DOWN;
+	fthd_hw_quiesce(dev_priv);
+	/* Descriptors and IOMMU entries live in S2 memory */
+	fthd_v4l2_buffers_unmap(dev_priv);
+	isp_uninit(dev_priv);
+	fthd_hw_deinit(dev_priv);
 	fthd_buffer_exit(dev_priv);
+}
 
