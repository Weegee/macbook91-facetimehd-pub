+/*
+ * Restart the camera hardware and resume a running stream. Called with
+ * vb2_queue_lock held.
+ */
+int fthd_hw_restart(struct fthd_private *dev_priv, bool power_cycle)
+{
+	int ret;
+
+	fthd_hw_teardown(dev_priv);
+
+	if (power_cycle) {
+		ret = fthd_power_cycle(dev_priv);
+		if (ret)
+			goto fail;
+	}
+
+	ret = fthd_hw_bringup(dev_priv);
+	if (ret)
+		goto fail;
+
+	ret = fthd_v4l2_buffers_remap(dev_priv);
+	if (ret)
+		goto fail_hw;
+
+	if (dev_priv->streaming) {
+		ret = fthd_v4l2_stream_restart(dev_priv);
+		if (ret)
+			goto fail_hw;
+	}
+	return 0;
+
+fail_hw:
+	/* The firmware did not take the stream; don't ask it to stop */
+	dev_priv->hw_state = FTHD_HW_FAILED;
+	fthd_hw_teardown(dev_priv);
+fail:
+	/* The chip is down now; streaming or recovery may try again */
+	return ret;
+}
+
+static void fthd_recover_work(struct work_struct *work)
+{
+	struct fthd_private *dev_priv =
+		container_of(work, struct fthd_private, recover_work);
+	int attempt, ret = -EIO;
+
+	mutex_lock(&dev_priv->vb2_queue_lock);
+
+	/* Resume brings the hardware up anyway, remove tears it down */
+	if (dev_priv->suspended || dev_priv->removing)
+		goto out;
+
+	for (attempt = 1; attempt <= FTHD_RECOVER_ATTEMPTS; attempt++) {
+		dev_warn(&dev_priv->pdev->dev,
+			 "restarting camera with power cycle (attempt %d of %d)\n",
+			 attempt, FTHD_RECOVER_ATTEMPTS);
+		ret = fthd_hw_restart(dev_priv, true);
+		if (!ret)
+			break;
+		msleep(500 * attempt);
+	}
+
+	dev_priv->recover_count++;
+	if (ret) {
+		dev_err(&dev_priv->pdev->dev,
+			"camera recovery failed (%d); close and reopen to retry\n",
+			ret);
+		fthd_v4l2_buffers_error(dev_priv);
+	} else {
+		dev_info(&dev_priv->pdev->dev, "camera recovered\n");
+	}
+out:
+	mutex_unlock(&dev_priv->vb2_queue_lock);
+}
+
+void fthd_schedule_recovery(struct fthd_private *dev_priv)
+{
+	schedule_work(&dev_priv->recover_work);
+}
