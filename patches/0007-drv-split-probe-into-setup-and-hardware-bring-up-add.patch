+static const char * const fthd_hw_state_names[] = {
+	[FTHD_HW_DOWN] = "down",
+	[FTHD_HW_STARTING] = "starting",
+	[FTHD_HW_UP] = "up",
+	[FTHD_HW_FAILED] = "failed",
+};
+
+static int seq_state_read(struct seq_file *seq, void *data)
+{
+	struct fthd_private *dev_priv = dev_get_drvdata(seq->private);
+
+	mutex_lock(&dev_priv->vb2_queue_lock);
+	seq_printf(seq, "hw_state: %s\nstreaming: %d\nsuspended: %d\nrecoveries: %u\n",
+		   fthd_hw_state_names[dev_priv->hw_state], dev_priv->streaming,
+		   dev_priv->suspended, dev_priv->recover_count);
+	mutex_unlock(&dev_priv->vb2_queue_lock);
+	return 0;
+}
+
+/* Writing anything power cycles the camera and waits for the result */
+static ssize_t fthd_store_recover(struct file *file, const char __user *user_buf,
+				  size_t count, loff_t *ppos)
+{
+	struct fthd_private *dev_priv = file->private_data;
+
+	fthd_schedule_recovery(dev_priv);
+	flush_work(&dev_priv->recover_work);
+	return count;
+}
+
+static const struct file_operations fops_recover = {
+	.write = fthd_store_recover,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
+
 static const struct file_operations fops_debug = {
 	.read = NULL,
 	.write = fthd_store_debug,
